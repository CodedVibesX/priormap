{
  "name": "priormap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns public CMS data into a ranked, routed New York account list of practices that prescribe drugs needing prior authorization, with a HubSpot import and a federal directory phone check.",
  "scripts": {
    "fetch": "tsx src/cli.ts fetch",
    "start": "tsx src/cli.ts run",
    "eval": "tsx src/cli.ts eval",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc --noEmit",
    "dev": "next dev -p 3008",
    "build": "next build",
    "shots": "node scripts/shoot.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "puppeteer-core": "^25.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
